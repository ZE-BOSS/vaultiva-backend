# ─────────────────────────────────────────────────────────────────────────────
# Vaultiva backend — environment template
# Copy to .env and fill in the blanks. .env is gitignored; never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=vaultiva_db

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1h
ENCRYPTION_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# ── Flutterwave (payments) ───────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Settlement account used for payouts. Leave blank until you have it — the
# endpoints that need it fail with a message naming the missing variable.
FLUTTERWAVE_ACCOUNT_NAME=
FLUTTERWAVE_ACCOUNT_NUMBER=
FLUTTERWAVE_BANK_NAME=
FLUTTERWAVE_BANK_CODE=

# ── Xpress Wallet (bank accounts / transfers) ────────────────────────────────
XPRESS_BASEURL=https://payment.xpress-wallet.com/api/v1

# The bundled SDK signs in with email + password and reads back x-access-token
# (see src/modules/xpress-wallet/client/http-client.ts). The pk_/sk_ keys below
# are Xpress merchant API keys; the OpenAPI spec declares no key-based security
# scheme, so which of the two Xpress expects still needs confirming with them.
XPRESS_PUBLIC_KEY=
XPRESS_SECRET_KEY=
XPRESS_EMAIL=
XPRESS_PASSWORD=

# ── Email (verification codes, receipts) ─────────────────────────────────────
# Set ONE key. The provider is auto-selected from whichever is present; set
# EMAIL_PROVIDER to override. With none, codes are written to the log in
# development and startup is refused in production.
#
#   resend     3,000/month, 100/day free   https://resend.com   (recommended)
#   brevo      300/day free (~9,000/month) https://brevo.com
#   zeptomail  paid, from $2.50/10,000
#
# MAIL_FROM must be on a domain verified with that provider. vaultiva.com is
# NOT the domain in use — the site is vaultivahq.com.
EMAIL_PROVIDER=
MAIL_FROM=no-reply@vaultivahq.com
MAIL_FROM_NAME=Vaultiva

RESEND_API_KEY=
BREVO_API_KEY=

ZEPTO_URL=api.zeptomail.com/
ZEPTO_API_KEY=

# ── SMS / WhatsApp ───────────────────────────────────────────────────────────
# No gateway delivers to a Nigerian handset for free; Termii is pay-as-you-go
# at roughly NGN 4 per message. Leave unset and verify by email instead — see
# docs/verification.md. Sender IDs other than N-Alert need Termii approval.
SMS_PROVIDER=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# ── Sumsub (KYC) ─────────────────────────────────────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
